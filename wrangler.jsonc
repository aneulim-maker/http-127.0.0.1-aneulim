{
  // ── eulim-site 정적 배포 설정 ──────────────────────────────
  // 브라우저 업로더 대신 wrangler 로 올립니다.
  //   · 모든 파일 형식을 지원합니다 (mp4·webm·webp·wav·vcf …)
  //   · 바뀐 파일만 올립니다 (매번 168MB를 다시 올리지 않습니다)
  //   · .assetsignore 를 지켜 비공개 파일을 걸러냅니다
  //
  //  name 은 대시보드의 워커 이름(eulim)과 같습니다 →
  //  배포하면 https://eulim.dataplaner.workers.dev 가 그대로 갱신됩니다.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eulim",
  "account_id": "ab78e46e7f5be95962b8c0cdb70829a9",
  "compatibility_date": "2026-08-30",

  // 2026-10-24 — schedule-manager Phase 2(M1)부터 코드 있는 Worker로 전환.
  // "assets"는 그대로 두되 "main"을 추가했습니다. 정적 파일과 매치되는
  // 요청은 지금처럼 worker/index.js 를 거치지 않고 그대로 서빙됩니다
  // (run_worker_first를 켜지 않았으므로 기본 동작 — assets 우선).
  // 매치 안 되는 요청(예: /api/*)만 worker/index.js 가 처리합니다.
  "main": "worker/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // 확장자 없는 주소(/case-lms → case-lms.html)를 자동으로 맞춰 줍니다.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },

  // schedule-manager Phase 2용 D1 데이터베이스.
  // 2026-10-24 wrangler d1 create schedule-manager-db 로 실제 생성(APAC 리전).
  // 로컬 테스트:  npx wrangler d1 migrations apply schedule-manager-db --local
  // 실제 반영:    npx wrangler d1 migrations apply schedule-manager-db --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "schedule-manager-db",
      "database_id": "632d64d4-f5ec-4aaa-9e78-9d510162559b",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
